# Port the Express server listens on
PORT=3010

# Directory where queue/settings state (data/state.json) is stored
DATA_DIR=./data

# Where finished MP3s wait until the browser downloads them
# (defaults to $DATA_DIR/staging)
STAGING_DIR=./data/staging

# How long an undownloaded file is kept before the sweeper deletes it
FILE_RETENTION_MINUTES=360

# Path to the yt-dlp binary (must be installed separately, see README)
YTDLP_PATH=yt-dlp

# Path to the ffmpeg binary (must be installed separately, see README)
FFMPEG_PATH=ffmpeg
